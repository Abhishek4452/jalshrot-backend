# Database (either name works)
MONGO_URI=mongodb+srv://user:pass@cluster/dbname
# MONGODB_URI=mongodb+srv://user:pass@cluster/dbname
MONGO_DB=jalsrot

JWT_SECRET=change_this_to_a_long_random_string
PORT=5000

# Optional: comma-separated list of allowed frontend origins
# CLIENT_ORIGIN=http://localhost:5173

# Optional: comma-separated emails that are always government administrators
# GOVERNMENT_EMAILS=admin@example.com
HARDWARE_API_KEY=generate_a_long_random_key_for_field_devices
